# Copy to .env in the directory where you run doc-extract.
# Native CLI connecting to the Docker VLM. Compose wires its app internally.
DOCUMENT_ENGINE=paddle-vl
VLM_BACKEND=llama-cpp
VLM_SERVER_URL=http://localhost:8111/v1

# Watermark text handling: off | report | filter (PaddleOCR-VL only).
# report preserves content; filter excludes verified background-only blocks.
WATERMARK_MODE=off

# Docker VLM settings. Keep VLM_SERVER_URL in sync if you change VLM_PORT.
VLM_PORT=8111
VLM_CONTEXT_SIZE=8192

# Local Paddle: VLM_BACKEND=local and remove VLM_SERVER_URL.
# Apple Silicon: VLM_BACKEND=mlx and VLM_SERVER_URL=http://localhost:8111
